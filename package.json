{
  "name": "arena-wall",
  "version": "1.0.0",
  "private": true,
  "description": "Live wall for the idea, spec, arena, and draft pull request pipeline.",
  "type": "module",
  "bin": {
    "arena-wall": "./bin/arena-wall"
  },
  "scripts": {
    "build": "node --import tsx cli/build.ts",
    "start": "node --import tsx cli/arena-wall.ts serve",
    "arena-wall": "node --import tsx cli/arena-wall.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:e2e": "playwright test",
    "lint:spec": "node --import tsx cli/arena-wall.ts lint",
    "snapshot": "node --import tsx cli/arena-wall.ts snapshot --out docs/screenshots/wall-1920.png",
    "demo:gif": "node --import tsx scripts/record-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.24.2",
    "fast-check": "^4.1.1",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
