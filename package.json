{
  "name": "arena-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "arena-wall": "./cli/arena-wall"
  },
  "scripts": {
    "start": "node --import tsx cli/arena-wall.ts serve",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "demo-director": "node --import tsx scripts/demo-director.ts",
    "check": "vitest run && playwright test && node --import tsx scripts/demo-director.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@playwright/test": "^1.49.1",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
